diff --git a/src/dec/vp8_dec.c b/src/dec/vp8_dec.c
index 26831042..d7868009 100644
--- a/src/dec/vp8_dec.c
+++ b/src/dec/vp8_dec.c
@@ -34,6 +34,56 @@
 
 WEBP_ASSUME_UNSAFE_INDEXABLE_ABI
 
+//------------------------------------------------------------------------------
+// Per-thread working buffer pool (~10-20MB).
+// VP8Decoder struct is still calloc'd fresh, so all state remains clean.
+// Only the large dec->mem buffer is recycled across frames.
+// Uses pthread TLS (NOT __thread) because __thread in dlopen'd .so
+// on Android is broken because the dynamic linker doesn't init TLS blocks.
+//------------------------------------------------------------------------------
+#include <pthread.h>
+
+static pthread_key_t g_mem_pool_key;
+static pthread_once_t g_mem_pool_once = PTHREAD_ONCE_INIT;
+
+typedef struct { uint8_t* ptr; size_t size; } MemPoolEntry;
+
+static void MemPoolKeyInit(void) {
+  pthread_key_create(&g_mem_pool_key, free); // free pooled buffer on thread exit
+}
+
+static MemPoolEntry* MemPoolGet(void) {
+  pthread_once(&g_mem_pool_once, MemPoolKeyInit);
+  MemPoolEntry* e = (MemPoolEntry*)pthread_getspecific(g_mem_pool_key);
+  if (e == NULL) {
+    e = (MemPoolEntry*)calloc(1, sizeof(MemPoolEntry));
+    pthread_setspecific(g_mem_pool_key, e);
+  }
+  return e;
+}
+
+void VP8MemPoolReturn(void* mem, size_t size) {
+  if (mem == NULL || size == 0) return;
+  MemPoolEntry* e = MemPoolGet();
+  if (e->ptr != NULL) free(e->ptr);
+  e->ptr = (uint8_t*)mem;
+  e->size = size;
+}
+
+void* VP8MemPoolAcquire(size_t needed, size_t* out_size) {
+  MemPoolEntry* e = MemPoolGet();
+  if (e->ptr != NULL && e->size >= needed) {
+    void* mem = e->ptr;
+    *out_size = e->size;
+    e->ptr = NULL;
+    e->size = 0;
+    memset(mem, 0, *out_size);
+    return mem;
+  }
+  if (e->ptr != NULL) { free(e->ptr); e->ptr = NULL; e->size = 0; }
+  return NULL;
+}
+
 //------------------------------------------------------------------------------
 
