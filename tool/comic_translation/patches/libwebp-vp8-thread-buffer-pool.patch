   WebPGetWorkerInterface()->End(&dec->worker);
   WebPDeallocateAlphaMemory(dec);
-  WebPSafeFree(dec->mem);
+  VP8MemPoolReturn(dec->mem, dec->mem_size);  // return to pool, not free
   dec->mem = NULL;
   dec->mem_size = 0;
   WEBP_UNSAFE_MEMSET(&dec->br, 0, sizeof(dec->br));
